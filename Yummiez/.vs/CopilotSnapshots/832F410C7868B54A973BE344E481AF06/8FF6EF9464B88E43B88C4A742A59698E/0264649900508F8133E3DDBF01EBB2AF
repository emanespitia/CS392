## Standard .gitignore for Visual Studio / .NET projects
## Keeps editor/project specific and build artifacts out of source control

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/

# Visual Studio directory
.vs/

# Rider / IntelliJ
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Dotnet artifacts
artifacts/
*.log
*.vspscc

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Dotnet core
project.lock.json
project.fragment.lock.json

# Entity Framework migrations (keep source, but ignore generated artifacts if any)
# (no default ignore for Migrations folder to allow tracking migrations)

# User secrets and local config
secrets.json
appsettings.*.Local

# Publish output
/publish/
*.Publish.xml

# macOS
.DS_Store

# Windows thumbnail cache files
Thumbs.db

# Log files
*.log

# Coverage and test results
coverage*.json
coverage*.xml
*.coverage

# Ignore packages folders created by tools
node_modules/

# Ignore IIS Express settings and credentials
.vs/*/applicationhost.config

# Ignore db files
*.mdf
*.ldf

# Ignore temporary files
~$*
*~