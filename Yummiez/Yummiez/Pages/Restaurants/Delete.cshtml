@page
@model Yummiez.Pages.Restaurants.DeleteModel

@{
    ViewData["Title"] = "Delete Restaurant";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card detail-card">
            <div class="detail-card-header" style="background: linear-gradient(135deg, #c62828, #b71c1c);">
                <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                <h2>Delete Restaurant</h2>
                <p class="mb-0 opacity-75">Are you sure you want to delete this restaurant? This action cannot be undone.</p>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-store text-danger me-2"></i>
                            <div>
                                <small class="text-muted">Name</small>
                                <p class="mb-0 fw-semibold">@Model.Restaurant.Name</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-user text-danger me-2"></i>
                            <div>
                                <small class="text-muted">Owner</small>
                                <p class="mb-0 fw-semibold">@Model.Restaurant.OwnerName</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-map-marker-alt text-danger me-2"></i>
                            <div>
                                <small class="text-muted">Address</small>
                                <p class="mb-0 fw-semibold">@Model.Restaurant.Address</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-phone text-danger me-2"></i>
                            <div>
                                <small class="text-muted">Phone</small>
                                <p class="mb-0 fw-semibold">@(Model.Restaurant.Phone ?? "Not available")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <form method="post" class="mt-4">
                    <input type="hidden" asp-for="Restaurant.RestaurantId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Yes, Delete Restaurant
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
