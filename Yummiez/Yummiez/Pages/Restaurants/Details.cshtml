@page
@model Yummiez.Pages.Restaurants.DetailsModel

@{
    ViewData["Title"] = Model.Restaurant.Name;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card detail-card">
            @if (!string.IsNullOrEmpty(Model.Restaurant.ImageUrl))
            {
                <img src="@Model.Restaurant.ImageUrl" class="detail-card-img" alt="@Model.Restaurant.Name">
            }
            <div class="detail-card-header">
                <h2>@Model.Restaurant.Name</h2>
                @if (!string.IsNullOrEmpty(Model.Restaurant.Category))
                {
                    <span class="badge bg-light text-dark rounded-pill px-3 py-1 mb-2">@Model.Restaurant.Category</span>
                }
                <br />
                <span class="badge @(Model.Restaurant.IsOpen == true ? "bg-success" : "bg-danger") rounded-pill px-3 py-2">
                    <i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i>
                    @(Model.Restaurant.IsOpen == true ? "Open Now" : "Closed")
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-user text-success me-2"></i>
                            <div>
                                <small class="text-muted">Owner</small>
                                <p class="mb-0 fw-semibold">@Model.Restaurant.OwnerName</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-map-marker-alt text-success me-2"></i>
                            <div>
                                <small class="text-muted">Address</small>
                                <p class="mb-0 fw-semibold">@Model.Restaurant.Address</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-phone text-success me-2"></i>
                            <div>
                                <small class="text-muted">Phone</small>
                                <p class="mb-0 fw-semibold">@(Model.Restaurant.Phone ?? "Not available")</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-info-item">
                            <i class="fas fa-calendar text-success me-2"></i>
                            <div>
                                <small class="text-muted">Added</small>
                                <p class="mb-0 fw-semibold">@(Model.Restaurant.CreatedAt?.ToString("MMM dd, yyyy") ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent p-3">
                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && Model.Restaurant.IsOpen == true)
                {
                    <div class="card border-success mb-3">
                        <div class="card-body">
                            <h5 class="fw-bold text-success mb-3">
                                <i class="fas fa-utensils me-2"></i>Menu
                            </h5>
                            @foreach (var menuItem in Model.MenuItems)
                            {
                                <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                                    <div>
                                        <div class="fw-semibold">@menuItem.Name</div>
                                        <small class="text-muted">$@menuItem.Price.ToString("0.00")</small>
                                    </div>
                                    <form method="post" asp-page-handler="AddToCart" asp-route-id="@Model.Restaurant.RestaurantId">
                                        <input type="hidden" name="itemName" value="@menuItem.Name" />
                                        <input type="hidden" name="unitPrice" value="@menuItem.Price" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                        </button>
                                    </form>
                                </div>
                            }
                            <a asp-page="/Cart/Index" class="btn btn-outline-success mt-2">
                                <i class="fas fa-shopping-cart me-1"></i>View Cart
                            </a>
                        </div>
                    </div>
                }
                else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-shield-alt me-2"></i>Admins can manage restaurants but cannot place orders.
                    </div>
                }
                else if (Model.Restaurant.IsOpen != true)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="fas fa-clock me-2"></i>This restaurant is currently closed. Check back later!
                    </div>
                }
                <div class="d-flex gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-page="./Edit" asp-route-id="@Model.Restaurant.RestaurantId" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                    }
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="fas fa-list me-1"></i>Back to List
                    </a>
                    <a asp-page="/Index" class="btn btn-outline-success">
                        <i class="fas fa-home me-1"></i>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
