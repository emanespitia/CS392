@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card detail-card">
            <div class="detail-card-header">
                <i class="fas fa-shield-alt fa-2x mb-2"></i>
                <h2>Privacy Policy</h2>
                <p class="mb-0 opacity-75">Last updated: March 2026</p>
            </div>
            <div class="card-body p-4">
                <h4 class="fw-bold mt-2"><i class="fas fa-info-circle text-success me-2"></i>Overview</h4>
                <p class="text-muted">
                    Yummiez is a student project built for CS392 — Web Application Development. 
                    This privacy policy outlines how we handle information within this application.
                </p>

                <h4 class="fw-bold mt-4"><i class="fas fa-database text-success me-2"></i>Data We Collect</h4>
                <ul class="text-muted">
                    <li><strong>Account Information:</strong> Email address and password (encrypted) when you register</li>
                    <li><strong>Restaurant Data:</strong> Restaurant details entered by administrators</li>
                    <li><strong>Role Information:</strong> Your assigned role (Admin or User) for access control</li>
                </ul>

                <h4 class="fw-bold mt-4"><i class="fas fa-lock text-success me-2"></i>How We Protect Your Data</h4>
                <ul class="text-muted">
                    <li>Passwords are hashed using ASP.NET Core Identity's built-in security</li>
                    <li>All data is stored securely on Microsoft Azure SQL Server</li>
                    <li>HTTPS encryption is used for all communications</li>
                </ul>

                <h4 class="fw-bold mt-4"><i class="fas fa-graduation-cap text-success me-2"></i>Academic Use</h4>
                <p class="text-muted">
                    This application is developed solely for educational purposes as part of a university course. 
                    No data is sold, shared, or used for commercial purposes.
                </p>

                <div class="text-center mt-4">
                    <a asp-page="/Index" class="btn btn-outline-success">
                        <i class="fas fa-home me-1"></i>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
