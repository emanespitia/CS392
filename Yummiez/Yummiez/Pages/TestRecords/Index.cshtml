@page
@model Yummiez.Pages.TestRecords.IndexModel

@{
    ViewData["Title"] = "Test Records";
}

<h1>Test Records</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TestEliasMissaEM[0].ProjectName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestEliasMissaEM[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestEliasMissaEM[0].Budget)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestEliasMissaEM[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestEliasMissaEM[0].IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.TestEliasMissaEM)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ProjectName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Budget)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
