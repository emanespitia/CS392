@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container text-center">
        <h1 class="hero-title">Delicious food, delivered fast.</h1>
        <p class="hero-subtitle">Order from your favorite local restaurants.</p>
        
        <div class="search-bar-container mt-4">
            <form class="d-flex">
                <input class="form-control search-input" type="search" placeholder="Enter delivery address" aria-label="Search">
                <button class="btn btn-primary search-btn" type="submit">
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Categories (Mock) -->
<div class="container mb-5">
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a href="#" class="btn btn-light rounded-pill px-3 border shadow-sm">
            🍔 Burgers
        </a>
        <a href="#" class="btn btn-light rounded-pill px-3 border shadow-sm">
            🍕 Pizza
        </a>
        <a href="#" class="btn btn-light rounded-pill px-3 border shadow-sm">
            🍣 Sushi
        </a>
        <a href="#" class="btn btn-light rounded-pill px-3 border shadow-sm">
            🥗 Healthy
        </a>
        <a href="#" class="btn btn-light rounded-pill px-3 border shadow-sm">
            🍩 Desserts
        </a>
         <a href="#" class="btn btn-light rounded-pill px-3 border shadow-sm">
            ☕ Coffee
        </a>
    </div>
</div>

