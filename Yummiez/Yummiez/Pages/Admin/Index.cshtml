@page
@model Yummiez.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">
        <i class="fas fa-shield-alt me-2"></i>Admin Dashboard
    </h2>
    <a asp-page="/Index" class="btn btn-outline-success">
        <i class="fas fa-home me-1"></i>Back to Home
    </a>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="fas fa-store fa-2x text-success mb-2"></i>
                <h3 class="fw-bold mb-0">@Model.TotalRestaurants</h3>
                <small class="text-muted">Total Restaurants</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="fas fa-door-open fa-2x text-success mb-2"></i>
                <h3 class="fw-bold mb-0">@Model.OpenRestaurants</h3>
                <small class="text-muted">Open Now</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="fas fa-door-closed fa-2x text-danger mb-2"></i>
                <h3 class="fw-bold mb-0">@Model.ClosedRestaurants</h3>
                <small class="text-muted">Closed</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                <small class="text-muted">Registered Users</small>
            </div>
        </div>
    </div>
</div>

<!-- User Management -->
<div class="card detail-card">
    <div class="detail-card-header">
        <i class="fas fa-users fa-2x mb-2"></i>
        <h2>User Management</h2>
        <p class="mb-0 opacity-75">Manage user roles and permissions</p>
    </div>
    <div class="card-body p-4">
        @if (Model.Users.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-user me-1"></i>Name</th>
                            <th><i class="fas fa-user-tag me-1"></i>Role</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <i class="fas fa-user-circle text-muted me-1"></i>
                                    <a asp-page="/Admin/UserDetails" asp-route-userId="@user.Id" class="text-decoration-none fw-semibold">
                                        @user.FullName
                                    </a>
                                </td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="fas fa-crown me-1"></i>Admin
                                        </span>
                                    }
                                    else if (user.Role == "Driver")
                                    {
                                        <span class="badge bg-primary rounded-pill px-3 py-2">
                                            <i class="fas fa-car me-1"></i>Driver
                                        </span>
                                    }
                                    else if (user.Role == "Manager")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                            <i class="fas fa-briefcase me-1"></i>Manager
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2">
                                            <i class="fas fa-user me-1"></i>User
                                        </span>
                                    }
                                </td>
                                
                                <td class="text-end">
                                    <form method="post" asp-page-handler="UpdateRole" class="d-inline-flex gap-2 align-items-center">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="role" class="form-select form-select-sm" style="min-width: 130px;">
                                            @foreach (var role in Model.AssignableRoles)
                                            {
                                                if (role == user.Role)
                                                {
                                                    <option value="@role" selected>@role</option>
                                                }
                                                else
                                                {
                                                    <option value="@role">@role</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-save me-1"></i>Save
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Delete" class="d-inline ms-2" onsubmit="return confirm('Delete this user? This cannot be undone.');">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                <p class="text-muted">No users found.</p>
            </div>
        }
    </div>
</div>


    <!-- Driver Applications -->
    <div class="card detail-card mt-4">
        <div class="detail-card-header">
            <i class="fas fa-car fa-2x mb-2"></i>
            <h2>Driver Applications</h2>
            <p class="mb-0 opacity-75">Review submitted driver applications</p>
        </div>

        <div class="card-body p-4">
            @if (Model.Applications.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>License</th>
                                <th>Vehicle</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td>@app.FullName</td>
                                    <td>@app.LicenseNumber</td>
                                    <td>@app.VehicleType</td>
                                    <td>
                                        <span class="badge @(app.Status == "Pending" ? "bg-warning text-dark" :
                                            app.Status == "Approved" ? "bg-success" :
                                            "bg-danger")">
                                            @app.Status
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="/Admin/ApplicationDetails"
                                               asp-route-id="@app.Id"
                                               class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye me-1"></i>View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-car-crash fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No driver applications found.</p>
                </div>
            }
        </div>
    </div>


<div class="mt-3">
    <small class="text-muted">
        <i class="fas fa-info-circle me-1"></i>
        You cannot remove the last admin account. At least one admin must always exist.
    </small>
</div>

<div class="card detail-card mt-4">
    <div class="detail-card-header">
        <i class="fas fa-user-tie fa-2x mb-2"></i>
        <h2>Restaurant Manager Assignments</h2>
        <p class="mb-0 opacity-75">Assign each restaurant to a manager account</p>
    </div>
    <div class="card-body p-4">
        @if (Model.Restaurants.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Restaurant</th>
                            <th>Manager</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var restaurant in Model.Restaurants)
                        {
                            <tr>
                                <td>@restaurant.Name</td>
                                <td>
                                    <form method="post" asp-page-handler="AssignManager" class="d-inline-flex gap-2 align-items-center">
                                        <input type="hidden" name="restaurantId" value="@restaurant.RestaurantId" />
                                        <select name="managerUserId" class="form-select form-select-sm" style="min-width: 220px;">
                                            <option value="">-- Unassigned --</option>
                                            @foreach (var manager in Model.ManagerUsers)
                                            {
                                                var displayName = Model.ManagerDisplayNames.TryGetValue(manager.Id, out var name)
                                                    ? name
                                                    : (manager.UserName ?? manager.Email ?? "Unknown Manager");
                                                var optionLabel = $"{displayName} ({manager.Email ?? "No email"})";

                                                if (manager.Id == restaurant.ManagerUserId)
                                                {
                                                    <option value="@manager.Id" selected>@optionLabel</option>
                                                }
                                                else
                                                {
                                                    <option value="@manager.Id">@optionLabel</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-save me-1"></i>Save
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    @if (string.IsNullOrWhiteSpace(restaurant.ManagerUserId))
                                    {
                                        <span class="badge bg-secondary">Unassigned</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Assigned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No restaurants found.</p>
        }
    </div>
</div>

<!-- Drivers Status -->
<div class="card detail-card mt-4">
    <div class="detail-card-header">
        <i class="fas fa-car-side fa-2x mb-2"></i>
        <h2>Drivers</h2>
        <p class="mb-0 opacity-75">Monitor driver availability</p>
    </div>

    <div class="card-body p-4">
        @if (Model.Drivers.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Vehicle</th>
                            <th>License</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var driver in Model.Drivers)
                        {
                            var user = Model.Users.FirstOrDefault(u => u.Id == driver.IdentityUserId);

                            <tr>
                                <td>@(user?.Email ?? "Unknown")</td>
                                <td>@driver.VehicleType</td>
                                <td>@driver.LicenseNumber</td>
                                <td>
                                    @if (driver.IsAvailable)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="fas fa-circle me-1"></i>Online
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2">
                                            <i class="fas fa-circle me-1"></i>Offline
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-car-side fa-3x text-muted mb-3"></i>
                <p class="text-muted">No drivers found.</p>
            </div>
        }
    </div>
</div>