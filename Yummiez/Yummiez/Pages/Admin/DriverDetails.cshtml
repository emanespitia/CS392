@page
@model Yummiez.Pages.Admin.DriverDetailsModel
@{
    ViewData["Title"] = "Driver Details";
    var fullName = !string.IsNullOrWhiteSpace(Model.Profile?.FullName)
        ? Model.Profile!.FullName
        : (Model.Account?.UserName ?? Model.Account?.Email ?? "Unknown Driver");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">
        <i class="fas fa-id-card me-2"></i>Driver Details
    </h2>
    <a asp-page="/Admin/Index" class="btn btn-outline-success">
        <i class="fas fa-arrow-left me-1"></i>Back to Admin
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h4 class="mb-3">@fullName</h4>

        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Account?.Email ?? "N/A")</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber) ? Model.Profile.PhoneNumber : "N/A")</dd>

            <dt class="col-sm-3">Vehicle Type</dt>
            <dd class="col-sm-9">@(Model.Driver.VehicleType ?? "N/A")</dd>

            <dt class="col-sm-3">License Number</dt>
            <dd class="col-sm-9">@(Model.Driver.LicenseNumber ?? "N/A")</dd>

            <dt class="col-sm-3">Availability</dt>
            <dd class="col-sm-9">@(Model.Driver.IsAvailable ? "Online" : "Offline")</dd>

            <dt class="col-sm-3">Driver Since</dt>
            <dd class="col-sm-9">@Model.Driver.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</dd>

            <dt class="col-sm-3">Application Status</dt>
            <dd class="col-sm-9">@(Model.Application?.Status ?? "N/A")</dd>

            <dt class="col-sm-3">Vehicle Info</dt>
            <dd class="col-sm-9">@(Model.Application?.VehicleInfo ?? "N/A")</dd>
        </dl>
    </div>
</div>
