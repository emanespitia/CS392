@page "{id:int}"
@model Yummiez.Pages.Admin.ApplicationDetailsModel
@{
    var application = Model.Application;
}

<h2>Driver Application Details</h2>

@if (application is null)
{
    <div class="alert alert-warning">Application not found.</div>
}
else
{
    <div class="card p-4">
        <p><strong>Name:</strong> @application.FullName</p>
        <p><strong>License:</strong> @application.LicenseNumber</p>
        <p><strong>Vehicle Type:</strong> @application.VehicleType</p>
        <p><strong>Vehicle Info:</strong> @application.VehicleInfo</p>
        <p><strong>Status:</strong> @application.Status</p>
    </div>

    <br />

    @if (application.Status == "Pending")
    {
        <form method="post" asp-page-handler="Approve">
            <input type="hidden" name="id" value="@application.Id" />
            <button class="btn btn-success">Approve</button>
        </form>

        <form method="post" asp-page-handler="Reject" class="mt-2">
            <input type="hidden" name="id" value="@application.Id" />
            <button class="btn btn-danger">Reject</button>
        </form>
    }
}