@page
@model Yummiez.Pages.Manager.IndexModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="fas fa-briefcase me-2"></i>Manager Dashboard</h2>
    <a asp-page="/Restaurants/Index" class="btn btn-outline-success">
        <i class="fas fa-store me-1"></i>Restaurants
    </a>
</div>

@if (Model.Restaurant == null)
{
    <div class="alert alert-warning">
        You are not assigned to a restaurant yet. Ask an admin to assign your manager account to a restaurant.
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <h5 class="fw-bold mb-1">@Model.Restaurant.Name</h5>
            <p class="text-muted mb-2">@Model.Restaurant.Address</p>
            <a asp-page="/Manager/Restaurant" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-edit me-1"></i>Edit My Restaurant
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3"><i class="fas fa-receipt me-2"></i>Incoming Orders</h5>
            @if (Model.Orders.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order</th>
                                <th>Address</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>#@order.OrderId</td>
                                    <td>@order.DeliveryAddress</td>
                                    <td><span class="badge bg-secondary">@order.Status</span></td>
                                    <td class="text-end">
                                        @if (order.Status == "Placed")
                                        {
                                            <form method="post" asp-page-handler="AcceptOrder" class="d-inline">
                                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                                <button class="btn btn-sm btn-primary">
                                                    <i class="fas fa-check me-1"></i>Accept
                                                </button>
                                            </form>
                                        }
                                        else if (order.Status == "Accepted")
                                        {
                                            <form method="post" asp-page-handler="MarkReady" class="d-inline">
                                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                                <button class="btn btn-sm btn-success">
                                                    <i class="fas fa-box me-1"></i>Mark Ready
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No orders yet for this restaurant.</p>
            }
        </div>
    </div>
}
