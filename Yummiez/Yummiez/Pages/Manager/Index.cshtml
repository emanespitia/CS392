@page
@model Yummiez.Pages.Manager.IndexModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="fas fa-briefcase me-2"></i>Manager Dashboard</h2>
    <a asp-page="/Restaurants/Index" class="btn btn-outline-success">
        <i class="fas fa-store me-1"></i>Restaurants
    </a>
</div>

@if (Model.Restaurant == null)
{
    <div class="alert alert-warning">
        You are not assigned to a restaurant yet. Ask an admin to assign your manager account to a restaurant.
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <h5 class="fw-bold mb-1">@Model.Restaurant.Name</h5>
            <p class="text-muted mb-2">@Model.Restaurant.Address</p>
            <a asp-page="/Manager/Restaurant" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-edit me-1"></i>Edit My Restaurant
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3"><i class="fas fa-receipt me-2"></i>Incoming Orders</h5>
            @if (Model.Orders.Any())
            {
                <div class="accordion" id="managerOrdersAccordion">
                    @foreach (var order in Model.Orders)
                    {
                        var headingId = $"order-heading-{order.OrderId}";
                        var collapseId = $"order-collapse-{order.OrderId}";
                        var customerName = Model.CustomerNames.TryGetValue(order.UserId, out var displayName)
                            ? displayName
                            : (order.CustomerName ?? "Customer");

                        <div class="accordion-item mb-2 border rounded">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                    <div class="w-100 d-flex justify-content-between align-items-center pe-2">
                                        <div>
                                            <strong>Order #@order.OrderId</strong>
                                            <span class="text-muted ms-2">for @customerName</span>
                                        </div>
                                        <span class="badge bg-secondary">@order.Status</span>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#managerOrdersAccordion">
                                <div class="accordion-body">
                                    <p class="mb-1"><strong>Customer:</strong> @customerName</p>
                                    <p class="mb-1"><strong>Delivery Address:</strong> @order.DeliveryAddress</p>
                                    <p class="mb-1"><strong>Placed:</strong> @order.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</p>
                                    <p class="mb-3"><strong>Items:</strong> @(string.IsNullOrWhiteSpace(order.ItemsSummary) ? "No item details available." : order.ItemsSummary)</p>

                                    @if (order.Status == "Placed")
                                    {
                                        <form method="post" asp-page-handler="AcceptOrder" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <button class="btn btn-sm btn-primary">
                                                <i class="fas fa-check me-1"></i>Accept
                                            </button>
                                        </form>
                                    }
                                    else if (order.Status == "Accepted")
                                    {
                                        <form method="post" asp-page-handler="MarkReady" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <button class="btn btn-sm btn-success">
                                                <i class="fas fa-box me-1"></i>Mark Ready
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No action available for this status.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No orders yet for this restaurant.</p>
            }
        </div>
    </div>
}
