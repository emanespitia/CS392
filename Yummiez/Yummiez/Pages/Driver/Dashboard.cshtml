@page
@model DashboardModel

<div class="container mt-5">
    <h2 class="mb-4">🚗 Driver Dashboard</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model.Driver != null)
    {
        <div class="card shadow-sm p-4">
            <div class="row">

                <!-- Driver Info -->
                <div class="col-md-6">
                    <h5 class="mb-3">Driver Info</h5>

                    <p><strong>Vehicle:</strong> @Model.Driver.VehicleType</p>
                    <p><strong>License:</strong> @Model.Driver.LicenseNumber</p>

                    <p>
                        <strong>Status:</strong>
                        @if (Model.Driver.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Offline</span>
                        }
                    </p>
                </div>

                <!-- Actions -->
                <div class="col-md-6 d-flex align-items-center justify-content-center">
                    <form method="post" asp-page-handler="ToggleAvailability">
                        <button class="btn btn-lg @(Model.Driver.IsAvailable ? "btn-danger" : "btn-success")">
                            @(Model.Driver.IsAvailable ? "Go Offline" : "Go Available")
                        </button>
                    </form>
                </div>

            </div>
        </div>

        <div class="alert alert-info mt-3" id="locationStatus">
            <i class="fas fa-location-arrow me-1"></i>Location sharing is required while delivering. Click "Start Location Sharing" below.
        </div>

        <div class="mb-3">
            <button id="startLocationBtn" type="button" class="btn btn-outline-primary">
                <i class="fas fa-map-marker-alt me-1"></i>Start Location Sharing
            </button>
        </div>

        <div class="card shadow-sm p-4 mt-4">
            <h5>📦 Ready for Pickup</h5>
            @if (Model.AvailableOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Restaurant</th>
                                <th>Address</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.AvailableOrders)
                            {
                                <tr>
                                    <td>#@order.OrderId</td>
                                    <td>@(order.Restaurant?.Name ?? "Restaurant")</td>
                                    <td>@order.DeliveryAddress</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="AcceptPickup" class="d-inline accept-pickup-form">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <input type="hidden" name="driverLat" />
                                            <input type="hidden" name="driverLng" />
                                            <button class="btn btn-sm btn-primary">Accept Pickup</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No ready orders right now.</p>
            }
        </div>

        <div class="card shadow-sm p-4 mt-4">
            <h5>🚚 My Active Deliveries</h5>
            @if (Model.MyActiveOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Restaurant</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.MyActiveOrders)
                            {
                                <tr data-active-order-id="@order.OrderId">
                                    <td>#@order.OrderId</td>
                                    <td>@(order.Restaurant?.Name ?? "Restaurant")</td>
                                    <td>@order.Status</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="MarkDelivered" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <button class="btn btn-sm btn-success">Mark Delivered</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No active deliveries.</p>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No driver profile found.
        </div>
    }
</div>

<script>
    let locationWatchId = null;
    const statusBox = document.getElementById('locationStatus');
    const startBtn = document.getElementById('startLocationBtn');

    function setStatus(message, type) {
        if (!statusBox) return;
        statusBox.className = `alert alert-${type} mt-3`;
        statusBox.innerHTML = `<i class="fas fa-location-arrow me-1"></i>${message}`;
    }

    async function postDriverLocation(orderId, lat, lng) {
        await fetch(`/api/orders/${orderId}/driver-location`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lat, lng })
        });
    }

    function getActiveOrderIds() {
        const orderNodes = document.querySelectorAll('[data-active-order-id]');
        return Array.from(orderNodes).map(n => parseInt(n.getAttribute('data-active-order-id'), 10)).filter(Number.isFinite);
    }

    function startLocationSharing() {
        if (!navigator.geolocation) {
            setStatus('Geolocation is not supported in this browser.', 'danger');
            return;
        }

        locationWatchId = navigator.geolocation.watchPosition(async position => {
            const activeOrderIds = getActiveOrderIds();
            if (activeOrderIds.length === 0) {
                setStatus('Location enabled. Waiting for active deliveries.', 'secondary');
                return;
            }

            const { latitude, longitude } = position.coords;
            await Promise.all(activeOrderIds.map(id => postDriverLocation(id, latitude, longitude)));
            setStatus('Sharing live location for active deliveries.', 'success');
        }, err => {
            setStatus(`Location permission error: ${err.message}`, 'danger');
        }, {
            enableHighAccuracy: true,
            maximumAge: 5000,
            timeout: 10000
        });
    }

    if (startBtn) {
        startBtn.addEventListener('click', startLocationSharing);
    }

    async function captureCurrentLocation() {
        if (!navigator.geolocation) {
            throw new Error('Geolocation is not supported in this browser.');
        }

        return await new Promise((resolve, reject) => {
            navigator.geolocation.getCurrentPosition(
                pos => resolve(pos.coords),
                err => reject(new Error(err.message)),
                {
                    enableHighAccuracy: true,
                    maximumAge: 5000,
                    timeout: 10000
                }
            );
        });
    }

    document.querySelectorAll('.accept-pickup-form').forEach(form => {
        form.addEventListener('submit', async event => {
            const latInput = form.querySelector('input[name="driverLat"]');
            const lngInput = form.querySelector('input[name="driverLng"]');
            if (!latInput || !lngInput) {
                return;
            }

            event.preventDefault();
            try {
                const coords = await captureCurrentLocation();
                latInput.value = coords.latitude;
                lngInput.value = coords.longitude;
                form.submit();
            } catch (error) {
                setStatus(`Location permission is required before pickup: ${error.message}`, 'danger');
            }
        });
    });
</script>