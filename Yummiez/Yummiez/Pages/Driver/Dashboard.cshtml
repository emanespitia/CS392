@page
@model DashboardModel

<div class="container mt-5">
    <h2 class="mb-4">🚗 Driver Dashboard</h2>

    @if (Model.Driver != null)
    {
        <div class="card shadow-sm p-4">
            <div class="row">

                <!-- Driver Info -->
                <div class="col-md-6">
                    <h5 class="mb-3">Driver Info</h5>

                    <p><strong>Vehicle:</strong> @Model.Driver.VehicleType</p>
                    <p><strong>License:</strong> @Model.Driver.LicenseNumber</p>

                    <p>
                        <strong>Status:</strong>
                        @if (Model.Driver.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Offline</span>
                        }
                    </p>
                </div>

                <!-- Actions -->
                <div class="col-md-6 d-flex align-items-center justify-content-center">
                    <form method="post" asp-page-handler="ToggleAvailability">
                        <button class="btn btn-lg @(Model.Driver.IsAvailable ? "btn-danger" : "btn-success")">
                            @(Model.Driver.IsAvailable ? "Go Offline" : "Go Available")
                        </button>
                    </form>
                </div>

            </div>
        </div>

        <div class="card shadow-sm p-4 mt-4">
            <h5>📦 Ready for Pickup</h5>
            @if (Model.AvailableOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Restaurant</th>
                                <th>Address</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.AvailableOrders)
                            {
                                <tr>
                                    <td>#@order.OrderId</td>
                                    <td>@(order.Restaurant?.Name ?? "Restaurant")</td>
                                    <td>@order.DeliveryAddress</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="AcceptPickup" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <button class="btn btn-sm btn-primary">Accept Pickup</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No ready orders right now.</p>
            }
        </div>

        <div class="card shadow-sm p-4 mt-4">
            <h5>🚚 My Active Deliveries</h5>
            @if (Model.MyActiveOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Restaurant</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.MyActiveOrders)
                            {
                                <tr>
                                    <td>#@order.OrderId</td>
                                    <td>@(order.Restaurant?.Name ?? "Restaurant")</td>
                                    <td>@order.Status</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="MarkDelivered" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <button class="btn btn-sm btn-success">Mark Delivered</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No active deliveries.</p>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No driver profile found.
        </div>
    }
</div>