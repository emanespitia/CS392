@page
@model Yummiez.Pages.Driver.ApplyModel

<h2>Apply to Become a Driver</h2>

@if (Model.CurrentStatus == null)
{
    <form method="post">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Application.FullName" class="form-label"></label>
            <input asp-for="Application.FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Application.LicenseNumber" class="form-label"></label>
            <input asp-for="Application.LicenseNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Application.VehicleType" class="form-label"></label>
            <input asp-for="Application.VehicleType" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Vehicle Details (Make, Model, Year, Color)</label>
            <input asp-for="Application.VehicleInfo" class="form-control" placeholder="e.g. 2018 Toyota Camry, Black" />
        </div>

        <button type="submit" class="btn btn-success">
            Submit Application
        </button>

    </form>
}
else
{
    @if (Model.CurrentStatus == "Pending")
    {
        <div class="alert alert-warning">
            Your application is <strong>Pending approval</strong>.
        </div>
    }
    else if (Model.CurrentStatus == "Approved")
    {
        <div class="alert alert-success">
            🎉 You are approved as a driver!
        </div>
    }
    else if (Model.CurrentStatus == "Rejected")
    {
        <div class="alert alert-danger">
            Your application was rejected.
        </div>
    }
}


