@page
@model Yummiez.Pages.FAQ.IndexModel
@{
    ViewData["Title"] = "FAQ";
    var groupedFaqs = Model.FaqItems
        .GroupBy(f => f.Category)
        .OrderBy(g => g.Key)
        .ToList();
    int accordionIndex = 0;
}

<!-- Hero Section -->
<div class="row justify-content-center mb-4">
    <div class="col-md-10">
        <div class="card detail-card mb-4">
            <div class="detail-card-header text-center">
                <i class="fas fa-question-circle fa-3x mb-3"></i>
                <h1 class="display-5 fw-bold">Frequently Asked Questions</h1>
                <p class="lead mb-0 opacity-75">Find answers to common questions about Yummiez</p>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="row justify-content-center mb-4">
    <div class="col-md-10">
        <div class="card detail-card">
            <div class="card-body p-4">
                <!-- Search Bar -->
                <form method="get" class="mb-3">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               name="Search"
                               class="form-control border-start-0 ps-0"
                               placeholder="Search for questions..."
                               value="@Model.Search"
                               id="faqSearchInput" />
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <a href="/FAQ" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-success">Search</button>
                    </div>
                </form>

                <!-- Category Filters -->
                <div class="d-flex flex-wrap gap-2">
                    <a href="/FAQ"
                       class="btn @(string.IsNullOrWhiteSpace(Model.Category) && string.IsNullOrWhiteSpace(Model.Search) ? "btn-success" : "btn-outline-success") rounded-pill px-3">
                        <i class="fas fa-th-large me-1"></i>All
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        var icon = cat switch
                        {
                            "Orders" => "fa-receipt",
                            "Account" => "fa-user-circle",
                            "Delivery" => "fa-truck",
                            "Payments" => "fa-credit-card",
                            _ => "fa-tag"
                        };
                        <a href="/FAQ?Category=@cat"
                           class="btn @(Model.Category == cat ? "btn-success" : "btn-outline-success") rounded-pill px-3">
                            <i class="fas @icon me-1"></i>@cat
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Content -->
<div class="row justify-content-center mb-5">
    <div class="col-md-10">
        @if (Model.MongoError)
        {
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                <div>
                    <strong>FAQ database is currently unavailable.</strong>
                    Please check back later or contact support for assistance.
                </div>
            </div>
        }
        else if (!Model.FaqItems.Any())
        {
            <div class="card detail-card">
                <div class="card-body p-5 text-center">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No results found</h4>
                    <p class="text-muted mb-3">Try a different search term or browse by category.</p>
                    <a href="/FAQ" class="btn btn-success rounded-pill px-4">
                        <i class="fas fa-arrow-left me-2"></i>View All FAQs
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var group in groupedFaqs)
            {
                <div class="card detail-card mb-4">
                    <div class="card-body p-4">
                        <h3 class="fw-bold mb-3">
                            @{
                                var catIcon = group.Key switch
                                {
                                    "Orders" => "fa-receipt",
                                    "Account" => "fa-user-circle",
                                    "Delivery" => "fa-truck",
                                    "Payments" => "fa-credit-card",
                                    _ => "fa-tag"
                                };
                            }
                            <i class="fas @catIcon text-success me-2"></i>@group.Key
                        </h3>

                        <div class="accordion" id="accordion-@group.Key.ToLower().Replace(" ", "-")">
                            @foreach (var faq in group)
                            {
                                var collapseId = $"faq-collapse-{accordionIndex}";
                                var headingId = $"faq-heading-{accordionIndex}";
                                <div class="accordion-item border-0 mb-2 rounded-3 overflow-hidden" style="background: var(--bs-light, #f8f9fa);">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button collapsed fw-semibold"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId"
                                                style="background: transparent; box-shadow: none;">
                                            <i class="fas fa-chevron-right me-2 accordion-chevron" style="font-size: 0.75rem; transition: transform 0.3s;"></i>
                                            @faq.Question
                                        </button>
                                    </h2>
                                    <div id="@collapseId"
                                         class="accordion-collapse collapse"
                                         aria-labelledby="@headingId"
                                         data-bs-parent="#accordion-@group.Key.ToLower().Replace(" ", "-")">
                                        <div class="accordion-body text-muted pt-0 ps-5">
                                            @faq.Answer
                                            @if (faq.Tags.Any())
                                            {
                                                <div class="mt-2">
                                                    @foreach (var tag in faq.Tags)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success me-1">#@tag</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                accordionIndex++;
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <!-- AI Help Section -->
        <div class="card detail-card border-0" style="background: linear-gradient(135deg, #198754 0%, #0d6e3d 100%);">
            <div class="card-body p-5 text-center text-white">
                <i class="fas fa-robot fa-3x mb-3 opacity-75"></i>
                <h3 class="fw-bold">Didn't find your answer?</h3>
                <p class="mb-3 opacity-75">Our AI-powered assistant is coming soon to help you with any questions!</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="mailto:support@yummiez.com" class="btn btn-light rounded-pill px-4">
                        <i class="fas fa-envelope me-2"></i>Contact Support
                    </a>
                    <a asp-page="/About" class="btn btn-outline-light rounded-pill px-4">
                        <i class="fas fa-info-circle me-2"></i>About Yummiez
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Rotate chevron icons on accordion expand/collapse
        document.querySelectorAll('.accordion-button').forEach(btn => {
            btn.addEventListener('click', () => {
                const chevron = btn.querySelector('.accordion-chevron');
                if (chevron) {
                    const isCollapsed = btn.classList.contains('collapsed');
                    chevron.style.transform = isCollapsed ? 'rotate(90deg)' : 'rotate(0deg)';
                }
            });
        });

        // Client-side instant search filtering
        const searchInput = document.getElementById('faqSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase();
                if (query.length === 0) {
                    document.querySelectorAll('.accordion-item').forEach(item => {
                        item.style.display = '';
                    });
                    return;
                }
                document.querySelectorAll('.accordion-item').forEach(item => {
                    const text = item.textContent.toLowerCase();
                    item.style.display = text.includes(query) ? '' : 'none';
                });
            });
        }
    </script>
}
